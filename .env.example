# Razorpay (Test Mode)
# Use RAZORPAY_KEY / RAZORPAY_SECRET (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET also accepted)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Existing Razorpay Plan IDs — never create plans from the app
RAZORPAY_PLAN_UNAGENCY_AI_MONTHLY=
RAZORPAY_PLAN_UNAGENCY_HYBRID_MONTHLY=
RAZORPAY_PLAN_UNAGENCY_HUMAN_MONTHLY=
RAZORPAY_PLAN_UNAGENCY_AI_ANNUAL=
RAZORPAY_PLAN_UNAGENCY_HYBRID_ANNUAL=
RAZORPAY_PLAN_UNAGENCY_HUMAN_ANNUAL=
# Recurring cycle counts (not one-time)
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_MONTHLY=120
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_ANNUAL=10

# Demo seed (npm run seed:demo)
DEMO_USER_PASSWORD=DemoPass123!
DEMO_SEED_MODE=true
# DEMO_USER_EMAIL=demo@unagency.test
# DEMO_FIREBASE_TOKEN=   # optional, for seed:verify

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# App URLs
FRONTEND_URL=
BACKEND_URL=

# Enterprise API (M9.2A / M9.2B / M9.2D2)
# ENTERPRISE_API_EXECUTION_MODE=stub
# M10.5 application integration (credential-free): use simulated so ControllableDispatcher runs
# ENTERPRISE_API_EXECUTION_MODE=simulated
# ENTERPRISE_API_EXECUTION_MODE=live
# ENTERPRISE_DEFAULT_PRODUCT_MODE=ai
# ENTERPRISE_API_USE_INTEGRATION_LAYER=false
# ENTERPRISE_API_SEED_DEMO_TENANT=true
# ENTERPRISE_API_FIREBASE_BRIDGE=true
# M10.11 local tip: disable legacy Bull workers if Redis hits maxmemory OOM
# ENTERPRISE_API_START_LEGACY_WORKERS=false
# Create path is always thin/direct (applyDirectPassthroughMetadata in prepass).
# No ENTERPRISE_API_DIRECT_PROVIDER_PASSTHROUGH toggle — removed as dead config.

# Live provider (required when ENTERPRISE_API_EXECUTION_MODE=live)
# Keys auto-enable the provider unless *_ENABLED=false. Restart backend after adding keys.
#
# === Client matrix → env map (add as billing is ready) ===
# TEXT: OPENAI_*, ANTHROPIC_*, GEMINI_* (or GOOGLE_*), XAI_*, DEEPSEEK_*, ALIBABA_*,
#       MOONSHOT_*, GROQ_*/META_*, MISTRAL_*, PERPLEXITY_* (research-as-text)
# IMAGE: OPENAI_* (gpt-image-1), GEMINI_* (gemini-*-image), IDEOGRAM_*, RECRAFT_*
# VIDEO: RUNWAY_*, KLING_*, LUMA_*, MINIMAX_*, PIXVERSE_*, GOOGLE_* (Veo)
#        (Pika/Higgsfield/Heygen/Seedance/Wan catalogued until API verified)
# AUDIO: ELEVENLABS_*, CARTESIA_*, OPENAI_* (tts-1 / whisper-1)
#        (PlayAI/Sesame/Suno catalogued until API verified)
# RESEARCH search tools: EXA_*, TAVILY_* (+ Perplexity via text)
#
# OPENAI_API_KEY=
# OPENAI_ENABLED=true
# ANTHROPIC_API_KEY=
# ANTHROPIC_ENABLED=true
# GEMINI_API_KEY=   (preferred for Gemini text + Gemini/Imagen-style image)
# GEMINI_ENABLED=true
# GOOGLE_API_KEY=   (fallback for Gemini text; also Veo video when GOOGLE_ENABLED)
# GOOGLE_ENABLED=true
# COHERE_API_KEY=
# COHERE_ENABLED=true
# GROQ_API_KEY=
# GROQ_ENABLED=true
# DEEPSEEK_API_KEY=
# DEEPSEEK_ENABLED=true
# MISTRAL_API_KEY=
# MISTRAL_ENABLED=true
# TOGETHER_API_KEY=
# TOGETHER_ENABLED=true
# FIREWORKS_API_KEY=
# FIREWORKS_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_ENABLED=true
# XAI_API_KEY=
# XAI_ENABLED=true
# ALIBABA_API_KEY=
# ALIBABA_ENABLED=true
# MOONSHOT_API_KEY=
# MOONSHOT_ENABLED=true
# META_API_KEY=
# META_ENABLED=true
# PERPLEXITY_API_KEY=
# PERPLEXITY_ENABLED=true
# AI_PROVIDER_TIMEOUT_MS=
# ENTERPRISE_API_DURABLE_MODE=true
# REDIS_HOST=   (or legacy REDIES_HOST)
# REDIS_PORT=6379
# REDIS_TLS=false   (default; set true only if your Redis endpoint requires TLS)

# Optional
PRODUCTION_PATH_PUPPITER=

# M9.5 Image providers (verified: Ideogram / Recraft / Gemini Image)
# IDEOGRAM_API_KEY=
# IDEOGRAM_ENABLED=true
# RECRAFT_API_KEY=
# RECRAFT_ENABLED=true
# Midjourney / HiDream / Reve / Picsart / Freepik are catalogued but LIVE-blocked until contract verification
# MIDJOURNEY_API_KEY=
# HIDREAM_API_KEY=
# REVE_API_KEY=
# PICSART_API_KEY=
# FREEPIK_API_KEY=

# Research search (Exa / Tavily)
# EXA_API_KEY=
# EXA_ENABLED=true
# TAVILY_API_KEY=
# TAVILY_ENABLED=true

# M9.5E / M9.5F — Video providers
# LIVE requires verified adapter in code + credentials + *_ENABLED.
# Manual *_VIDEO_CONTRACT_VERIFIED cannot enable unverified/fake adapters.
# RUNWAY_API_KEY=
# RUNWAY_ENABLED=true
# KLING_API_KEY=              # Bearer API key (KLING_ACCESS_KEY accepted as legacy alias)
# KLING_ENABLED=true
# LUMA_API_KEY=
# LUMA_ENABLED=true
# PIKA_API_KEY=
# PIKA_ENABLED=true
# MINIMAX_API_KEY=
# MINIMAX_ENABLED=true
# PIXVERSE_API_KEY=
# PIXVERSE_ENABLED=true
# GOOGLE_API_KEY=
# GOOGLE_ENABLED=true
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_KEY_SECRET=
# HIGGSFIELD_ENABLED=true
# Heygen / Seedance / Wan are catalogued but LIVE-blocked until contract verification
# HEYGEN_API_KEY=
# HEYGEN_ENABLED=true
# SEEDANCE_API_KEY=          # WaveSpeed — paused (set SEEDANCE_ENABLED=true to re-enable)
# SEEDANCE_ENABLED=false
# WAN_API_KEY=
# WAN_ENABLED=true
# M9.5G / M9.5G1 — Video LIVE certification (deferred until credentials exist)
# Implementation is complete without keys. Activation = env only (see docs/M9.5G1_LIVE_CERTIFICATION_MANIFEST.md)
# VIDEO_CERTIFICATION_PROVIDER=provider.runway
# Per-vendor smoke (ALL required: smoke=true + EXECUTION_MODE=live + DURABLE_MODE + ASYNC_MEDIA + credentials)
# RUN_LIVE_RUNWAY_VIDEO_SMOKE=false
# RUN_LIVE_KLING_VIDEO_SMOKE=false
# RUN_LIVE_LUMA_VIDEO_SMOKE=false
# RUN_LIVE_MINIMAX_VIDEO_SMOKE=false
# RUN_LIVE_PIXVERSE_VIDEO_SMOKE=false
# RUN_LIVE_GOOGLE_VIDEO_SMOKE=false
# RUN_LIVE_HEYGEN_VIDEO_SMOKE=false
# RUN_LIVE_SEEDANCE_VIDEO_SMOKE=false
# RUN_LIVE_WAN_VIDEO_SMOKE=false
# ENTERPRISE_ASYNC_MEDIA_ENABLED=true
# Brand Vault / product assets (M10.4+) — required for Save to Vault in LIVE.
# Use the same bucket as legacy multer-S3 (prakriadirect) or set PRODUCT_ASSET_STORAGE=memory for local-only tests.
# ENTERPRISE_BLOB_BUCKET=prakriadirect
# ENTERPRISE_BLOB_SIGNED_URL_TTL_SECONDS=300
# PRODUCT_ASSET_STORAGE=memory

# M9.5I — Audio / speech LIVE certification (deferred until credentials exist)
# ELEVENLABS_API_KEY=
# ELEVENLABS_ENABLED=true
# CARTESIA_API_KEY=
# CARTESIA_ENABLED=true
# OPENAI already supports whisper-1 + tts-1 via OPENAI_API_KEY
# PlayAI / Sesame / Suno / Udio / Stability audio remain catalogued but LIVE-blocked
# PLAYAI_API_KEY=
# SESAME_API_KEY=
# SUNO_API_KEY=
# UDIO_API_KEY=
# STABILITY_API_KEY=
# Per-vendor smoke (ALL required: smoke=true + ENTERPRISE_API_EXECUTION_MODE=live + credentials)
# RUN_LIVE_OPENAI_AUDIO_SMOKE=false
# RUN_LIVE_ELEVENLABS_AUDIO_SMOKE=false
# RUN_LIVE_CARTESIA_AUDIO_SMOKE=false

# M9.5K — Embeddings runtime (credential-free boot; LIVE smoke deferred)
# OPENAI_API_KEY=   (shared with text)
# OPENAI_ENABLED=true
# COHERE_API_KEY=
# COHERE_ENABLED=true
# MISTRAL_API_KEY=
# MISTRAL_ENABLED=true
# Gemini embedding inventory model is BLOCKED (deprecated text-embedding-004)
# Per-vendor smoke (ALL required: smoke=true + ENTERPRISE_API_EXECUTION_MODE=live + credentials)
# RUN_LIVE_OPENAI_EMBEDDING_SMOKE=false
# RUN_LIVE_COHERE_EMBEDDING_SMOKE=false
# RUN_LIVE_MISTRAL_EMBEDDING_SMOKE=false

# M9.5L — Tool calling + structured output (offline-first; no credentials required)
# TOOL_EXECUTION_ENABLED=true
# TOOL_MAX_ROUNDS=5
# TOOL_MAX_CALLS_PER_EXECUTION=20
# TOOL_MAX_CALLS_PER_ROUND=5
# TOOL_EXECUTION_TIMEOUT_MS=5000
# TOOL_REQUIRE_APPROVAL_FOR_SIDE_EFFECTS=true
# Future LIVE smoke (DO NOT enable without approval + credentials):
# RUN_LIVE_OPENAI_TOOL_SMOKE=false
# RUN_LIVE_OPENAI_STRUCTURED_OUTPUT_SMOKE=false

# M9.5H — Adaptive routing + provider failover (no credentials required)
# Adaptive feedback is OFF by default — preserves deterministic static ranking.
# ADAPTIVE_ROUTING_ENABLED=false
# ADAPTIVE_ROUTING_FEEDBACK_WEIGHT=0.25
# ADAPTIVE_ROUTING_MIN_SAMPLES=20
# ADAPTIVE_ROUTING_WINDOW_DAYS=30
# ADAPTIVE_ROUTING_EXPLORATION_RATE=0
# ADAPTIVE_ROUTING_STATIC_FLOOR=0.15
# ADAPTIVE_ROUTING_MAX_PERF_CONTRIBUTION=0.35
# ADAPTIVE_ROUTING_TENANT_OVERLAY=true
# PROVIDER_FAILOVER_ENABLED=true
# PROVIDER_FAILOVER_MAX_ATTEMPTS=3
# PROVIDER_FAILOVER_MAX_FAILOVERS=2
# PROVIDER_FAILOVER_MAX_LATENCY_MS=120000
# PROVIDER_FAILOVER_MAX_SUBMITTED_PAID_JOBS=2

# M9.5P — Evaluation integrity (no credentials; no fabricated routing quality)
# EVALUATION_ENABLED=true
# EVALUATION_FEEDBACK_MIN_TRUST=medium
# EVALUATION_MAX_DEPTH=1

# M9.5Q — Cost intelligence (UNKNOWN COST ≠ ZERO; empty catalogue = ready)
# COST_INTELLIGENCE_ENABLED=true
# COST_BUDGET_MODE=disabled

# M9.5O — Streaming runtime (native incremental only)
# STREAMING_ENABLED=true
# STREAM_MAX_BUFFER_BYTES=1048576
# STREAM_CONNECT_TIMEOUT_MS=30000
# STREAM_FIRST_OUTPUT_TIMEOUT_MS=30000
# STREAM_IDLE_TIMEOUT_MS=60000
# STREAM_MAX_DURATION_MS=600000
# STREAM_SHUTDOWN_DRAIN_MS=5000

# M9.5O1 — LIVE stream smokes (default false; never key-alone)
# RUN_LIVE_OPENAI_STREAM_SMOKE=false
# RUN_LIVE_ANTHROPIC_STREAM_SMOKE=false
# RUN_LIVE_GROQ_STREAM_SMOKE=false
# RUN_LIVE_ELEVENLABS_TTS_STREAM_SMOKE=false

# Track A — Smart Continuity (default OFF; see docs/A0_ROLLOUT_PLAN.md)
# Rollout: off → shadow → canary → on. Shadow = observe only, no ASK/block.
# CONTINUITY_APPROVE_PROMOTE=shadow
# CONTINUITY_CONTEXT_BIND=shadow
# CONTINUITY_POST_GUARDS=shadow
# CONTINUITY_PRODUCT_UX=shadow
# CONTINUITY_PACKS=off
# CONTINUITY_BRIEF_ASSIST=off
# CONTINUITY_CAMPAIGN_MEMORY=off

# Track B3 — Creative QA (10 dimensions × /10 → /100; block release below 80)
# CREATIVE_QA=off|shadow|canary|on
# CREATIVE_QA=shadow
