{
  "name": "prakria-direct-api",
  "version": "1.0.0",
  "description": "Basic express template with all error handling in typescript",
  "main": "index.js",
  "bin": "./bin/cli.js",
  "scripts": {
    "start": "ENTERPRISE_API_START_LEGACY_WORKERS=false TS_NODE_TRANSPILE_ONLY=true ts-node ./index.ts",
    "start:dist": "node dist/index.js",
    "build": "tsc",
    "bun:start": "bun ./index.ts",
    "dev": "nodemon --exec TS_NODE_TRANSPILE_ONLY=true ts-node ./index.ts",
    "seed:demo": "ts-node ./scripts/seed-demo-data.ts",
    "seed:categories": "ts-node ./scripts/seed-categories.ts",
    "seed:demo:reset": "ts-node ./scripts/seed-demo-reset.ts",
    "seed:verify": "node ./scripts/verify-seed.mjs",
    "createPackage": "echo {\"type\":\"module\"} > ./dist/package.json",
    "prod:build": "bun build  --entrypoints ./index.ts --outdir ./dist --target node --minify-whitespace --minify-identifiers --minify-syntax --sourcemap=linked && npm run createPackage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.16",
    "@types/puppeteer": "^5.4.7",
    "@types/uuid": "^10.0.0",
    "aws-sdk": "^2.1689.0",
    "axios": "^1.13.2",
    "body-parser": "^1.20.3",
    "bullmq": "^5.25.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.4.0",
    "googleapis": "^164.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.7.0",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.15",
    "puppeteer": "^24.31.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "stripe": "^16.12.0",
    "types": "^0.1.1",
    "uuid": "^10.0.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "bun": "^1.1.20",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "author": "prakria",
  "license": "ISC"
}
