{
  "name": "prakria-direct-api",
  "version": "1.0.0",
  "description": "Basic express template with all error handling in typescript",
  "main": "index.js",
  "bin": "./bin/cli.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node ./index.ts",
    "createPackage": "echo {\"type\":\"module\"} > ./dist/package.json",
    "prod:build": "bun build  --entrypoints ./index.ts --outdir ./dist --target node --minify-whitespace --minify-identifiers --minify-syntax --sourcemap=linked && npm run createPackage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@types/express": "^4.17.21",
    "aws-sdk": "^2.1689.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.7.0",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "stream-chat": "^8.40.4",
    "stripe": "^16.10.0",
    "types": "^0.1.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^20.14.2",
    "bun": "^1.1.20",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "author": "prakria",
  "license": "ISC"
}
